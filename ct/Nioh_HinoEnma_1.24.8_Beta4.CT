<?xml version='1.0' encoding='utf-8'?>
<CheatTable CheatEngineTableVersion="45">
  <CheatEntries>
    <CheatEntry>
      <ID>1000</ID>
      <Description>"飞缘魔 1.0.0 Beta 4：在标题菜单启用"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1" />
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
if getAddressSafe("HE_Prototype_Code") then error("飞缘魔测试版已启用。") end
local module
for _, item in pairs(enumModules()) do if item.Name:lower()=="nioh.exe" then module=item end end
if not module then error("请先选择 nioh.exe 进程。") end
if getModuleSize("nioh.exe")~=50782208 then error("游戏模块与测试版不匹配。") end
if md5file(module.PathToFile):lower()~="4870ca50224e886984cef33c251e92d6" then error("本表只适配已核对的 Steam 1.24.8 程序。") end
_G.HE_Prototype_PID=getOpenedProcessID()
