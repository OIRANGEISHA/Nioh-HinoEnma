      <CheatEntries>
        <CheatEntry>
          <ID>1001</ID>
          <Description>"下次载入的角色"</Description>
          <VariableType>4 Bytes</VariableType>
          <Address>HE_Prototype_Data+0</Address>
          <ShowAsHex>1</ShowAsHex>
          <DropDownList DisplayValueAsItem="1">00000000:威廉
00058E5E:飞缘魔 A
00051BE1:飞缘魔 B</DropDownList>
        </CheatEntry>
        <CheatEntry>
          <ID>1002</ID>
          <Description>"操控辅助 A（沿用旧表）"</Description>
          <VariableType>Byte</VariableType>
          <Address>HE_Prototype_Data+28</Address>
          <ShowAsHex>1</ShowAsHex>
          <DropDownList DisplayValueAsItem="1">00:默认
01:开启</DropDownList>
        </CheatEntry>
        <CheatEntry>
          <ID>1003</ID>
          <Description>"操控辅助 B（沿用旧表）"</Description>
          <VariableType>Byte</VariableType>
          <Address>HE_Prototype_Data+29</Address>
          <ShowAsHex>1</ShowAsHex>
          <DropDownList DisplayValueAsItem="1">00:默认
01:模式 1
02:模式 2</DropDownList>
        </CheatEntry>
        <CheatEntry>
          <ID>1004</ID>
          <Description>"交互兼容模式"</Description>
          <VariableType>Byte</VariableType>
          <Address>HE_Prototype_Data+2A</Address>
          <ShowAsHex>1</ShowAsHex>
          <DropDownList DisplayValueAsItem="1">00:关闭
