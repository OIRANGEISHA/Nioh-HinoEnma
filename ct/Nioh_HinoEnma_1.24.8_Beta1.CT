local bytes=readBytes(site,5,true)
if not bytes or bytes[1]~=0xE9 then error("HE_WeaponHudRangedSwitch 已被其他脚本改动。") end
local delta=bytes[2]+bytes[3]*256+bytes[4]*65536+bytes[5]*16777216
if delta&gt;=2147483648 then delta=delta-4294967296 end
if site+5+delta~=getAddress("HE_WeaponHudRangedSwitch") then error("跳转目标已变化，停止恢复。") end
local site=getAddress("nioh.exe+751296")
local bytes=readBytes(site,5,true)
if not bytes or bytes[1]~=0xE9 then error("HE_Revenant 已被其他脚本改动。") end
local delta=bytes[2]+bytes[3]*256+bytes[4]*65536+bytes[5]*16777216
if delta&gt;=2147483648 then delta=delta-4294967296 end
if site+5+delta~=getAddress("HE_Revenant") then error("跳转目标已变化，停止恢复。") end
